name = "ledu-school-archive"
pages_build_output_dir = "."
compatibility_date = "2026-08-20"

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "ledu-school-archive"
database_id = "<创建 D1 后填写>"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "ledu-school-archive"
